# Python
__pycache__/
*.pyc
*.egg-info/
*venv*/
/.mypy_cache*

# Test coverage
htmlcov/
.coverage
.coverage.*

# Node (files at the root are created by the devcontainers cli)
node_modules/
/package.json
/package-lock.json

# Rust
target/
*.rs.bk

# Build artifacts
dist/
build/
*.so
/web/.build.lock
/web/cockpit/.build.lock
/web/cockpit/.dist-*
/web/sdk/.dist-*

# Nix / direnv (symlink one of the tracked .envrc.* files to .envrc)
.direnv/
.envrc

# Nix build output symlinks
result
result-*

# Editor and OS files
.vscode/
.DS_Store

# Local environment and secrets
.env
.ssh/
.bash_history

# AI dev tools
.claude
CLAUDE.md
CLAUDE.MD
/.mcp.json
.opencode/
.omo/
.slim/deepwork/
.codegraph/

# Test data: ignore data/ but keep the compressed LFS archives
data/*
!data/.lfs/

# Runtime output
/logs
/recordings
results/
/assets/output/
/assets/rgbd_data/
/assets/saved_maps/
/assets/model-cache/
/assets/agent/memory.txt
/assets/teleop_certs/
/misc/fresh-ubuntu-tests/cache

# Default output of `dimos apriltag`
/apriltags.pdf

/thread_monitor_report.csv

# Memory autorecord
recording*.db

# Rerun recordings
*.rrd

# Profiler output
*.speedscope.json

# Downloaded model weights
FastSAM-x.pt
yolo11n*.pt
*mobileclip*

# openspec
/openspec/changes/archive/

# Generic ignore patterns
*.ignore
*.ignore.*
site/

# Local G1 maps and point-cloud recordings are too large for GitHub.
/maps/
*.lcm
/data/.lfs/*.db

